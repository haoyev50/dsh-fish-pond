{
  "name": "deep-fish-pond",
  "version": "0.1.0",
  "description": "DSH 桌面宠物：小鲸鱼蹲在右下角，把日报精选和评论一句话一句话说出来；可拖动、可悬浮到桌面",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "bilibili"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "render/pond_window.py",
    "assets/art/idle.webp",
    "assets/art/swim.webp",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT"
}
